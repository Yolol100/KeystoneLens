import hashlib
import re
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
APP_DIR = ROOT / "app" / "keystonelens_companion"
DATA_TOC = ROOT / "data-addon" / "KeystoneLensCompanionData" / "KeystoneLensCompanionData.toc"
ADDON_TOC = ROOT / "addon" / "KeystoneLensBridge" / "KeystoneLensBridge.toc"
ADDON_SYNC = APP_DIR / "addon_sync.py"
SETUP_PS1 = ROOT / "installer" / "windows" / "bootstrap" / "installer.ps1"
SETUP_GO = ROOT / "installer" / "windows" / "bootstrap" / "main.go"
WIN_BUILD = ROOT / "installer" / "windows" / "build.sh"
SIGN_SCRIPT = ROOT / "installer" / "windows" / "sign-release.ps1"
VERIFY_SIGNATURES = ROOT / "installer" / "windows" / "verify-signatures.ps1"
WOW_WATCHER = ROOT / "installer" / "windows" / "wowwatcher" / "main.go"
UNINSTALLER = ROOT / "installer" / "windows" / "uninstall" / "main.go"
RELEASE_BUILD = ROOT / "scripts" / "BUILD-RELEASE.sh"
RELEASE_NOTES = ROOT / "docs" / "RELEASE-NOTES-0.12.7.md"


def _text(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def test_version_is_pinned_to_0127_across_runtime_and_release_contracts():
    init = _text(APP_DIR / "__init__.py")
    assert '__version__ = "0.12.7"' in init
    assert "## Version: 0.12.7" in _text(ADDON_TOC)
    assert "## Version: 0.12.7" in _text(DATA_TOC)
    assert "$Version = '0.12.7'" in _text(SETUP_PS1)
    assert 'VERSION="0.12.7"' in _text(RELEASE_BUILD)
    assert "# KeystoneLens 0.12.7" in _text(RELEASE_NOTES)


def test_no_0128_literal_remains_in_source_tree():
    bad = []
    for path in ROOT.rglob("*"):
        if not path.is_file():
            continue
        if any(part in {"release", "build", "__pycache__"} for part in path.parts):
            continue
        if path.suffix.lower() in {".exe", ".zip", ".pyc", ".ico", ".tga"}:
            continue
        try:
            data = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        if "0.12.8" in data:
            bad.append(str(path.relative_to(ROOT)))
    assert not bad, bad


def test_generated_companion_toc_does_not_reference_unmaterialized_media_asset():
    addon_sync = _text(ADDON_SYNC)
    assert "KeystoneLensIcon" not in addon_sync
    assert "## IconTexture:" not in addon_sync
    assert "Data.lua" in addon_sync


def test_static_data_addon_toc_has_only_materialized_runtime_files():
    toc = _text(DATA_TOC)
    file_lines = [line.strip() for line in toc.splitlines() if line.strip() and not line.startswith("##")]
    assert file_lines == ["Data.lua"]
    assert "IconTexture" not in toc


def test_rio_client_rejects_malformed_success_payloads_before_caching():
    rio = _text(APP_DIR / "rio.py")
    assert "Raider.IO returned invalid JSON" in rio
    assert "Raider.IO returned malformed character data" in rio
    assert 'isinstance(data.get("name"), str)' in rio
    assert "self.cache.set(key, result.to_dict())" in rio


def test_wow_autodetect_refuses_ambiguous_known_retail_installations():
    config = _text(APP_DIR / "config.py")
    assert "known_existing" in config
    assert "if len(known_existing) == 1" in config
    assert "return \"\"" in config


def test_crash_log_records_version_component_severity_and_bounds_growth():
    main = _text(APP_DIR / "__main__.py")
    assert "__version__" in main
    assert "[FATAL]" in main
    assert "KeystoneLens Companion" in main
    assert "max_log_bytes" in main


def test_installer_recovers_atomic_swap_backup_before_existing_install_state():
    ps1 = _text(SETUP_PS1)
    restore_at = ps1.index("if (-not (Test-Path $InstallDir) -and (Test-Path $BackupDir))")
    state_at = ps1.index("$ExistingInstall = Test-Path")
    delete_at = ps1.index("Remove-Item -LiteralPath $BackupDir -Recurse -Force -ErrorAction SilentlyContinue", state_at)
    assert restore_at < state_at < delete_at


def test_installer_has_branded_decision_progress_success_and_diagnostics_flow():
    ps1 = _text(SETUP_PS1)
    assert 'Height="540" Width="690"' in ps1
    assert 'x:Name="BrandIcon"' in ps1
    assert 'x:Name="DecisionPanel"' in ps1
    assert 'x:Name="ProgressPanel" Visibility="Collapsed"' in ps1
    assert 'x:Name="FinishPanel" Visibility="Collapsed"' in ps1
    assert 'x:Name="ErrorPanel" Visibility="Collapsed"' in ps1
    assert 'x:Name="DetailsExpander" Header="Details"' in ps1
    assert 'x:Name="DetailsText"' in ps1
    assert 'x:Name="Cancel" Content="Cancel"' in ps1
    assert 'x:Name="Install" Content="Install"' in ps1
    assert 'x:Name="Open" Content="Open KeystoneLens"' in ps1
    assert 'x:Name="CopyDiagnostics" Content="Copy diagnostics"' in ps1
    assert "#0D1016" in ps1 and "#141923" in ps1 and "#5DA8FF" in ps1
    assert "install.log" in ps1
    assert "$MaxInstallLogBytes = 1024 * 1024" in ps1


def test_installer_launch_modes_are_mutually_exclusive_and_desktop_is_opt_in():
    ps1 = _text(SETUP_PS1)
    assert 'x:Name="ManualRadio"' in ps1
    assert 'x:Name="WindowsRadio"' in ps1
    assert 'x:Name="WowRadio"' in ps1
    assert ps1.count('GroupName="LaunchMode"') == 3
    assert 'x:Name="Desktop" Content="Create desktop shortcut" IsChecked="False"' in ps1
    assert 'x:Name="LaunchAfter" Content="Launch KeystoneLens after installation" IsChecked="True"' in ps1
    assert "$PreviousLaunchMode = if (Test-Path $WoWWatcherShortcut) { 'wow' } elseif (Test-Path $StartupShortcut) { 'windows' } else { 'manual' }" in ps1
    assert "$script:SelectedLaunchMode = if ($wowRadio.IsChecked) { 'wow' } elseif ($windowsRadio.IsChecked) { 'windows' } else { 'manual' }" in ps1


def test_installer_has_real_download_byte_progress_and_safe_cancel_points():
    ps1 = _text(SETUP_PS1)
    assert "System.Net.Http.HttpCompletionOption" in ps1
    assert "ContentLength" in ps1
    assert "Format-Bytes $received" in ps1
    assert "22 + [int][Math]::Floor(20 * $fraction)" in ps1
    assert "Assert-NotCanceled" in ps1
    assert "$script:CancelRequested = $true" in ps1
    assert "$cancel.IsEnabled = $false" in ps1
    assert "Finishing the verified installation safely" in ps1


def test_installer_wow_launch_mode_creates_only_watcher_startup_shortcut():
    ps1 = _text(SETUP_PS1)
    assert "$WoWWatcherShortcut = Join-Path $StartupDir 'KeystoneLens-WoW-Watcher.lnk'" in ps1
    assert "Remove-Item -LiteralPath $StartupShortcut" in ps1
    assert "Remove-Item -LiteralPath $WoWWatcherShortcut" in ps1
    assert "New-Shortcut $WoWWatcherShortcut $watcherTarget $icon" in ps1
    assert "Start-WoWWatcherIfRequested" in ps1


def test_installer_result_file_prevents_duplicate_normal_failure_popup():
    ps1 = _text(SETUP_PS1)
    bootstrap = _text(SETUP_GO)
    assert "[string]$ResultFile = ''" in ps1
    assert "[System.IO.File]::WriteAllText($ResultFile, $status" in ps1
    assert 'resultPath := filepath.Join(temp, "result.txt")' in bootstrap
    assert '"-ResultFile", resultPath' in bootstrap
    assert 'if status == "failed"' in bootstrap
    assert 'if status == "canceled"' in bootstrap
    assert "Prefix UTF-8 BOM" in bootstrap
    assert "0xEF, 0xBB, 0xBF" in bootstrap


def test_installer_xaml_declares_x_namespace_and_is_strict_xml_parseable():
    ps1 = _text(SETUP_PS1)
    match = re.search(r"\[xml\]\$xaml = @'\n(.*?)\n'@", ps1, re.S)
    assert match, "installer XAML block not found"
    xaml = match.group(1)
    assert 'xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"' in xaml
    root = ET.fromstring(xaml)
    assert root.tag.endswith("Window")


def test_wow_watcher_is_path_validated_low_privilege_and_single_instance():
    watcher = _text(WOW_WATCHER)
    assert r"Local\KeystoneLens.WoWWatcher.Singleton" in watcher
    assert 'strings.EqualFold(filepath.Base(path), "Wow.exe")' in watcher
    assert 'strings.EqualFold(part, "_retail_")' in watcher
    assert "processQueryLimitedInformation = 0x1000" in watcher
    assert "QueryFullProcessImageNameW" in watcher
    assert "CreateToolhelp32Snapshot" in watcher
    assert 'filepath.Join(filepath.Dir(exe), "KeystoneLens.exe")' in watcher
    assert "time.Sleep(pollInterval)" in watcher
    assert "ReadProcessMemory" not in watcher
    assert "WriteProcessMemory" not in watcher
    assert "VirtualAllocEx" not in watcher
    assert "CreateRemoteThread" not in watcher
    assert "SetWindowsHookEx" not in watcher
    assert "SendInput" not in watcher
    assert "Battle.net" not in watcher


def test_uninstaller_and_build_pipeline_include_wow_watcher():
    uninstall = _text(UNINSTALLER)
    build = _text(WIN_BUILD)
    sign = _text(SIGN_SCRIPT)
    verify = _text(VERIFY_SIGNATURES)
    release = _text(RELEASE_BUILD)
    assert 'KeystoneLens-WoW-Watcher.exe' in uninstall
    assert 'KeystoneLens-WoW-Watcher.lnk' in uninstall
    assert 'wowwatcher/main.go' in build
    assert 'KeystoneLens-WoW-Watcher.exe' in build
    assert 'KeystoneLens WoW Launch Watcher' in build
    assert 'KeystoneLens-WoW-Watcher.exe' in sign
    assert 'KeystoneLens-WoW-Watcher.exe' in verify
    assert 'KeystoneLens-WoW-Watcher.exe' in release


def test_installer_download_source_and_runtime_hash_remain_pinned():
    ps1 = _text(SETUP_PS1)
    assert "python-3.13.15-amd64.exe" in ps1
    assert "https://www.python.org/ftp/python/3.13.15/python-3.13.15-amd64.exe" in ps1
    assert "edec09c4853aeae9ac36efb8c9f95b6b8e2fee65eee56d9767a8b7c69c574403" in ps1
    assert "Get-FileHash -Algorithm SHA256" in ps1


def test_companion_protocol_parser_source_hash_is_preserved():
    digest = hashlib.sha256((APP_DIR / "aps1.py").read_bytes()).hexdigest()
    assert digest == "75f4b6d998358b0cee637ea3d99ce03f9c3aef8bf8f2dde5e6a87087b54b4b71"
